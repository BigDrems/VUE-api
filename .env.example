# Supabase PostgreSQL connection string with PostGIS
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# JWT secrets - use strong random strings in production
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"
REDIS_URL="redis://default:your-redis-password@your-redis-host:your-redis-port"
# Server
PORT=3000
NODE_ENV=development

# Leyte terminal coordinates (geofence center)
TERMINAL_LAT=11.2543
TERMINAL_LNG=124.9945
TERMINAL_RADIUS_METERS=500
